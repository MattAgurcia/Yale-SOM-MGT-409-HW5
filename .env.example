# Copy to .env in the project root and fill in your key. Placeholders only:
# never commit the real .env. (Without a .env here, the backend uses the
# nearest .env in a parent folder.)

# --- Model access: gpt-6-luna through the Portkey gateway -------------------
PORTKEY_API_KEY=replace_with_your_portkey_api_key
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai

# --- Optional: point the MCP server and the audit trail elsewhere (e.g. tests)
# CAMPUS_DB_PATH=data/campus_customs_new.db
# CAMPUS_AUDIT_PATH=output/audit_trail.json

# --- Optional: per-ticket limits for the whole team (defaults shown)
# TEAM_MAX_REQUESTS=40
# TEAM_MAX_TOOL_CALLS=60
# TEAM_MAX_TOKENS=300000
# TEAM_MAX_OUTPUT_TOKENS=8000
# TEAM_REASONING_EFFORT=low
# TEAM_MAX_DELEGATIONS=8
# TEAM_MAX_DEPTH=2
# TEAM_TOOL_RETRIES=2
