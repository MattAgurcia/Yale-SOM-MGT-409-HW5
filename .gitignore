# Secrets: copy .env.example to .env and fill in your key. Never commit the real .env.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Front end (npm install / npm run build recreate these)
node_modules/
frontend/dist/

# Runtime side files (the databases themselves ARE committed)
output/*.lock
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.resetting

# OS and editor files
.DS_Store
.vscode/
.idea/
